# ====================================================================
# Hostinger Apache Production Configuration for CyTOS React SPA
# ====================================================================

# 1. Enable Rewrite Engine & Canonical Redirection
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS and non-WWW canonical domain (https://cytos.in)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.cytos\.in$ [NC]
  RewriteRule ^(.*)$ https://cytos.in/$1 [L,R=301]

  # Directly serve XML sitemap and robots.txt
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]

  # If an existing asset or directory is requested, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other routes rewrite to index.html for React Router DOM SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

# 2. MIME Types Support
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/pdf .pdf
  AddType application/json .json
</IfModule>

# 3. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# 4. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML files - Do not cache long so new deployments update immediately
  ExpiresByType text/html "access plus 0 seconds"

  # XML Sitemap and robots.txt - 1 hour cache so Googlebot always picks up latest changes
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Images and Media
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # PDFs
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
